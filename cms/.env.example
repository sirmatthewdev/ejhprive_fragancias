# SQLite file for local work; use a Postgres URL in production
DATABASE_URL=file:./ejh.db
# random string, 32+ chars
PAYLOAD_SECRET=
# public URL of this panel and of the shop (CORS/CSRF)
CMS_URL=http://localhost:3000
STORE_URL=http://localhost:4321
# optional, used by npm run seed
SEED_ADMIN1_EMAIL=
SEED_ADMIN1_NAME=
SEED_ADMIN2_EMAIL=
SEED_ADMIN2_NAME=
SEED_ADMIN1_PASSWORD=
SEED_ADMIN2_PASSWORD=
# reuse an existing storefront key when recreating the database
SEED_API_KEY=
