# --- Local ---
# Vacío = SQLite (./ejh.db). En producción la integración Neon crea DATABASE_URL (Postgres).
DATABASE_URL=
# Cadena aleatoria de 32+ caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# URL pública del panel. En producción es la tienda, que sirve /admin por proxy:
#   https://ejhprive-fragancias.vercel.app
# En local: http://localhost:3000 (panel directo) o http://127.0.0.1:4321 (a través de la tienda).
CMS_URL=http://localhost:3000
# Origen de la tienda (CORS/CSRF)
STORE_URL=http://localhost:4321
# Clave del usuario técnico «Tienda (API)»; la misma va en la tienda como CMS_API_KEY
SEED_API_KEY=
# Fotos de productos en Vercel Blob (solo producción)
BLOB_READ_WRITE_TOKEN=
# Solo para `npm run seed` en local (los administradores de producción se crean con `npm run create-admin`)
SEED_ADMIN1_EMAIL=
SEED_ADMIN1_NAME=
SEED_ADMIN1_PASSWORD=
SEED_ADMIN2_EMAIL=
SEED_ADMIN2_NAME=
SEED_ADMIN2_PASSWORD=
