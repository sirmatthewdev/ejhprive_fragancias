# Base de datos: Postgres en producción (Vercel → Storage → Neon crea DATABASE_URL/POSTGRES_URL).
# En local, si queda vacío, usa SQLite (archivo ./ejh.db).
DATABASE_URL=
# Cadena aleatoria de 32+ caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# URL pública de este panel (ej. https://admin.ejhprive.com) y de la tienda (CORS/CSRF)
CMS_URL=
STORE_URL=
# Primer arranque en producción: crea los 2 administradores y el usuario de la tienda con estos datos
SEED_ADMIN1_EMAIL=
SEED_ADMIN1_NAME=
SEED_ADMIN1_PASSWORD=
SEED_ADMIN2_EMAIL=
SEED_ADMIN2_NAME=
SEED_ADMIN2_PASSWORD=
# Debe ser igual a CMS_API_KEY en el proyecto de la tienda
SEED_API_KEY=
# Opcional: subida de archivos (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=
