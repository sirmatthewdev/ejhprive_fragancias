---
/** A photo that may come from the panel (URL) or be built in (optimised with astro:assets). */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  'class:list'?: unknown;
}
const { src, alt, widths, sizes, height, loading, class: cls } = Astro.props;
---
{typeof src === 'string'
  ? <img src={src} alt={alt} sizes={sizes} loading={loading ?? 'lazy'} decoding="async" class={cls} />
  : height
    ? <Image src={src} alt={alt} height={height} loading={loading} class={cls} />
    : <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} class={cls} />}
