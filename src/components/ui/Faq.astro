---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="border-t border-cream/12" data-reveal>
  {items.map((f) => (
    <details class="faq group border-b border-cream/12" name="faq">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[17px] font-semibold [&::-webkit-details-marker]:hidden">
        {f.q}
        <span class="relative size-5 shrink-0 text-lilac" aria-hidden="true">
          <span class="absolute inset-x-0 top-1/2 h-px bg-current"></span>
          <span class="absolute inset-y-0 left-1/2 w-px bg-current transition-transform duration-500 group-open:rotate-90 group-open:scale-y-0"></span>
        </span>
      </summary>
      <div class="faq-body"><p class="max-w-[60ch] pb-6 leading-relaxed text-sand">{f.a}</p></div>
    </details>
  ))}
</div>

<style>
  /* animated open/close where supported (interpolate-size), instant elsewhere */
  .faq::details-content { block-size: 0; overflow: hidden; transition: block-size .6s var(--ease-out-expo), content-visibility .6s allow-discrete; }
  .faq[open]::details-content { block-size: auto; }
  :global(:root) { interpolate-size: allow-keywords; }
</style>
