---
import { SITE } from '../../config/site';

interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
const base = Astro.site ?? SITE.url;
const ld = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.label, item: it.href ? new URL(it.href, base).href : undefined })),
};
---
<nav aria-label="Ruta de navegación" class="text-[13px] text-mist">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class="text-cream/25">/</span>}
        {it.href ? <a href={it.href} class="link-u inline-block py-2 text-sand hover:text-cream">{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
