---
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import { type Product, productUrl, FAMILIES } from '../data/products';
import { discount, money } from '../lib/cart';
import { liveOf, type Live } from '../lib/cms';

interface Props { p: Product; live?: Live; variant?: 'frasco' | 'decant'; priority?: boolean; headingLevel?: 'h2' | 'h3' }
const { p, live = liveOf(null, p.slug), variant = 'frasco', priority = false, headingLevel: H = 'h3' } = Astro.props;
const decant = variant === 'decant';
const soldOut = decant ? !live.available['3'] && !live.available['5'] : !live.available['100'];
const from = live.prices[decant ? '3' : '100'];
const off = discount(from.regular, from.price);
const tag = soldOut ? 'Agotado' : off ? `Oferta ${off}` : live.tag === undefined ? p.tag : live.tag;
// the fragrance photo identifies the card in both variants; the real decant photo shows on hover
const first = p.img;
const second = p.decant;
const tone = FAMILIES.find((f) => f.id === p.family)?.tone ?? '#5B3A8E';
const href = productUrl(p) + (decant ? '?formato=5' : '');
---
<article class:list={['group/card relative flex flex-col gap-4', soldOut && '[&_img]:grayscale-[.6] [&_img]:opacity-70']} data-family={p.family} data-cursor="Ver">
  <div class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-graphite ring-1 ring-cream/8">
    <Image
      src={first} alt={`${decant ? 'Decants de ' : ''}${p.brand} ${p.name}`} widths={[360, 560, 800]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
      loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined}
      class="absolute inset-0 size-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-out-expo)] group-hover/card:scale-[1.06]"
      transition:name={decant ? undefined : `img-${p.slug}`}
    />
    <!-- second shot fades in on hover: frasco ↔ decant -->
    <div class="absolute inset-0 opacity-0 transition-opacity duration-[900ms] ease-[var(--ease-out-expo)] group-hover/card:opacity-100 bg-[radial-gradient(70%_60%_at_50%_45%,var(--tone),transparent_75%),linear-gradient(180deg,#1a141f,#0b0a0d)]" style={`--tone:${tone}66`} aria-hidden="true">
      <Image src={second} alt="" widths={[360, 560]} sizes="(min-width: 1024px) 30vw, 90vw" loading="lazy"
        class="size-full scale-95 object-contain p-[12%] drop-shadow-[0_24px_30px_rgb(0_0_0/.55)] transition-transform duration-[900ms] ease-[var(--ease-out-expo)] group-hover/card:scale-100" />
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent_60%,rgb(11_10_13/.7))]"></div>
    {decant && !soldOut && <span class="chip absolute right-3.5 top-3.5 border border-cream/25 bg-onyx/70 text-cream backdrop-blur-md">Decant</span>}
    {tag && <span class:list={['chip absolute left-3.5 top-3.5 border backdrop-blur-md', soldOut ? 'border-cream/30 bg-onyx/85 text-sand' : off ? 'border-transparent bg-lilac text-plum' : 'border-lilac/35 bg-onyx/70 text-[#E5D9F5]']}>{tag}</span>}
    <ul class="absolute inset-x-3.5 bottom-3.5 flex flex-wrap gap-1.5" aria-label="Formatos disponibles">
      {((decant ? ['3', '5'] : ['3', '5', '100']) as const).map((f, i, a) => (
        <li class:list={['chip h-7 px-2.5 text-[11px]', !live.available[f] ? 'border border-cream/10 bg-onyx/60 text-cream/40 line-through' : i === a.length - 1 ? 'bg-cream text-plum' : 'border border-cream/20 bg-onyx/60 text-cream backdrop-blur-md']}>{f} ml{!live.available[f] && <span class="sr-only"> (agotado)</span>}</li>
      ))}
    </ul>
  </div>
  <div class="flex flex-col gap-1.5">
    <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-lilac">{p.brand}</p>
    <H class="text-[1.65rem] leading-[1.08]">
      <a href={href} class="after:absolute after:inset-0 after:content-['']">{decant ? `Decant ${p.name}` : p.name}</a>
    </H>
    <p class="text-[13px] text-mist">{p.accord}</p>
    <div class="mt-1.5 flex items-center justify-between border-t border-cream/10 pt-3">
      <p class="flex items-baseline gap-2 text-sm">
        <span class="text-mist">{decant ? 'Desde' : ''}</span>
        <span class:list={['font-semibold', off && 'text-lilac']}>{money(from.price)}</span>
        {off && <s class="text-xs text-mist" aria-label={`Precio regular ${money(from.regular)}`}>{money(from.regular)}</s>}
      </p>
      <span class="flex items-center gap-1.5 text-[13px] text-sand opacity-0 transition-[opacity,transform] duration-500 group-hover/card:translate-x-0 group-hover/card:opacity-100 max-lg:opacity-100 lg:-translate-x-2">
        Ver <Icon name="arrow" size={14} />
      </span>
    </div>
  </div>
</article>
