---
import { CMS_URL } from 'astro:env/server';
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';

// Team access lives in the admin panel (Payload). When it's deployed, this page just forwards there.
export const prerender = false;
if (CMS_URL) return Astro.redirect(`${CMS_URL.replace(/\/$/, '')}/admin`, 302);
---
<Base title="Panel de administración" noindex>
  <section class="wrap flex min-h-[60vh] flex-col items-center justify-center gap-5 py-20 text-center">
    <p class="kicker">Acceso del equipo</p>
    <h1 class="text-[clamp(2.4rem,5vw,4rem)] leading-none">Panel en configuración</h1>
    <p class="max-w-[30rem] leading-relaxed text-sand">El panel de administración todavía no está conectado a este dominio. Para comprar no necesitas cuenta: arma tu bolsa y finaliza por WhatsApp.</p>
    <a href="/productos/" class="btn btn-cream btn-fill">Ver la colección <Icon name="arrow" size={16} /></a>
  </section>
</Base>
