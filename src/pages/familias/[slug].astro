---
import CategoryView from '../../components/CategoryView.astro';
import { familyCategory, loadCategory } from '../../lib/categories';

export const prerender = false; // live products, prices and stock from the CMS

const page = await loadCategory(familyCategory, Astro.params.slug!, 'familias', Astro.response);
if (page instanceof Response) return page;
---
<CategoryView {...page} />
