# Panel (carpeta cms/): dirección interna a la que la tienda reenvía /admin, /cms-api y /cms-assets.
# Producción: https://ejhprive-cms.vercel.app · Local: http://localhost:3000
CMS_URL=http://localhost:3000
# API key del usuario «Tienda (API)» (la imprime npm run seed en cms/)
CMS_API_KEY=

# Seguimiento (opcional; cada herramienta carga solo si tiene ID y el visitante acepta cookies)
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=
# Cloudflare Web Analytics (sin cookies)
PUBLIC_CF_BEACON_TOKEN=
# URL pública de la tienda (canonical, sitemap, Open Graph)
SITE_URL=
